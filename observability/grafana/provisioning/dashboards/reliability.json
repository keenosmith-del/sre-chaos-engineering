{"title": "Distributed Reliability", "uid": "reliability", "schemaVersion": 40, "version": 1, "refresh": "5s", "panels": [{"id": 1, "title": "Request rate", "type": "timeseries", "datasource": {"uid": "prometheus", "type": "prometheus"}, "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "sum by(service)(rate(http_requests_total[1m]))", "refId": "A"}]}, {"id": 2, "title": "p95 latency", "type": "timeseries", "datasource": {"uid": "prometheus", "type": "prometheus"}, "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "histogram_quantile(0.95,sum by(service,le)(rate(http_request_duration_seconds_bucket[1m])))", "refId": "A"}]}, {"id": 3, "title": "Business outcomes", "type": "timeseries", "datasource": {"uid": "prometheus", "type": "prometheus"}, "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "sum by(service,outcome)(rate(business_outcomes_total[1m]))", "refId": "A"}]}, {"id": 4, "title": "Circuit states", "type": "timeseries", "datasource": {"uid": "prometheus", "type": "prometheus"}, "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "circuit_state", "refId": "A"}]}, {"id": 5, "title": "Queue backlog", "type": "timeseries", "datasource": {"uid": "prometheus", "type": "prometheus"}, "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "targets": [{"expr": "rabbitmq_queue_messages", "refId": "A"}]}, {"id": 6, "title": "Durable backlog", "type": "timeseries", "datasource": {"uid": "prometheus", "type": "prometheus"}, "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "targets": [{"expr": "durable_backlog", "refId": "A"}]}, {"id": 7, "title": "Retries", "type": "timeseries", "datasource": {"uid": "prometheus", "type": "prometheus"}, "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8}, "targets": [{"expr": "sum by(dependency)(rate(dependency_retries_total[1m]))", "refId": "A"}]}, {"id": 8, "title": "Scrape availability", "type": "timeseries", "datasource": {"uid": "prometheus", "type": "prometheus"}, "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8}, "targets": [{"expr": "up", "refId": "A"}]}]}